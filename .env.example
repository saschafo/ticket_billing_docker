# =============================================================================
# Konfiguration für den Frappe-16-Stack mit ERPNext 16 und der App
# ticket_billing.
# Kopie anlegen:  cp .env.example .env   und Werte anpassen.
# =============================================================================

COMPOSE_PROJECT_NAME=ticket-billing

# -----------------------------------------------------------------------------
# Image
# -----------------------------------------------------------------------------
# Wird von ./build.sh lokal gebaut. Für eine Registry z. B.:
#   CUSTOM_IMAGE=ghcr.io/<github-user>/ticket-billing
CUSTOM_IMAGE=ticket-billing/frappe
CUSTOM_TAG=16
# missing = nur ziehen, wenn lokal nicht vorhanden (richtig für selbst gebaute Images)
# always  = immer aus der Registry ziehen (für Server-Deployments)
PULL_POLICY=missing

# -----------------------------------------------------------------------------
# Frappe Framework (Build)
# -----------------------------------------------------------------------------
FRAPPE_PATH=https://github.com/frappe/frappe
FRAPPE_BRANCH=version-16
PYTHON_VERSION=3.14.2
NODE_VERSION=24.13.0

# -----------------------------------------------------------------------------
# ERPNext (Build)
# -----------------------------------------------------------------------------
# Wird VOR ticket_billing installiert -- die App setzt auf ERPNext auf.
ERPNEXT_REPO_URL=https://github.com/frappe/erpnext
ERPNEXT_BRANCH=version-16

# -----------------------------------------------------------------------------
# Ticket-Billing-App (Build)
# -----------------------------------------------------------------------------
# Woher der Build den App-Code nimmt:
#   git   = Der Build klont selbst aus APP_REPO_URL. Erst möglich, wenn das
#           Repo auf GitHub existiert.
#   local = Der Host klont nach ./apps-local/<APP_NAME>, der Build kopiert das
#           hinein. Für die App-Entwicklung: so lässt sich ein Stand testen,
#           bevor er gepusht ist. Achtung -- auch dann klont bench aus dem
#           Repo, es zählt also nur, was committet ist.
#
# Vorbelegt auf 'local', weil APP_REPO_URL noch nicht existiert. Das
# App-Grundgerüst liegt bereits unter ./apps-local/ticket_billing.
APP_SOURCE=local

# Platzhalter -- das Repo ist noch nicht angelegt. Erst nach dem ersten Push
# lässt sich APP_SOURCE=git verwenden.
APP_REPO_URL=https://github.com/saschafo/ticket_billing
APP_BRANCH=main
# Muss dem app_name aus hooks.py entsprechen (Ordnername in apps/)
APP_NAME=ticket_billing
# Nur für APP_SOURCE=local: URL, mit der der HOST klont (z. B. per SSH).
# Leer lassen = APP_REPO_URL wird verwendet.
APP_REPO_URL_HOST=
# Nur bei einem privaten Repo: Personal Access Token. Wird als BuildKit-Secret
# übergeben und landet NICHT in den Image-Layern.
APP_REPO_TOKEN=

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
SITE_NAME=ticketbilling.localhost
ADMIN_PASSWORD=CHANGE_ME_admin
# Welche Apps auf der Site installiert werden -- Reihenfolge zählt, ERPNext
# muss vor ticket_billing stehen. Wird bei jedem Start abgeglichen, bereits
# installierte Apps werden übersprungen.
# Anführungszeichen sind Pflicht: build.sh und ticket.sh lesen diese Datei mit
# 'source', ein unquotierter Wert mit Leerzeichen bricht dort ab.
SITE_APPS="erpnext ticket_billing"
# Sprache der Site. Bestimmt, in welcher Sprache Frappe serverseitige Texte
# erzeugt, und ist zugleich die Startsprache der Vue-Oberfläche (die Shell
# übernimmt sie über window.frappe_boot_lang). Wird nur beim Anlegen der Site
# gesetzt -- danach über System Settings im Desk ändern.
SITE_LANG=de
# Auf welchen Site-Namen eingehende Requests gemappt werden.
# Fester Wert = die Site ist unter jedem Hostnamen erreichbar (praktisch lokal).
# $$host    = Site wird anhand des Host-Headers aufgelöst (Mehr-Site-Betrieb).
# Verweist auf SITE_NAME und wandert damit automatisch mit. Stand hier
# frueher ein fester Name, lieferte nginx nach einer Aenderung von
# SITE_NAME weiterhin die alte Site aus -- Ergebnis war 404 auf allem,
# ohne jeden Hinweis auf die Ursache.
#
# Der feste Name sorgt dafuer, dass die Site unter jedem Hostnamen
# erreichbar ist (localhost, der Site-Name selbst, die IP des Rechners).
# Fuer Mehr-Site-Betrieb stattdessen auf $$host setzen.
FRAPPE_SITE_NAME_HEADER=${SITE_NAME}
# Bei jedem "up" automatisch 'bench migrate' fahren (1 = an, 0 = aus).
AUTO_MIGRATE=1

# -----------------------------------------------------------------------------
# Netzwerk
# -----------------------------------------------------------------------------
HTTP_PUBLISH_PORT=8080

# -----------------------------------------------------------------------------
# Datenbank
# -----------------------------------------------------------------------------
DB_PASSWORD=CHANGE_ME_db

# -----------------------------------------------------------------------------
# Gunicorn / Betrieb
# -----------------------------------------------------------------------------
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
RESTART_POLICY=unless-stopped
PROXY_READ_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=50m

# -----------------------------------------------------------------------------
# Nur fuer ./neu-aufsetzen.sh
#
# Damit fuellt das Skript den ERPNext-Einrichtungsassistenten aus. Fuer den
# normalen Betrieb ohne Belang -- der Assistent wird dort von Hand bedient.
# -----------------------------------------------------------------------------
DEMO_COMPANY="Musterfirma"
DEMO_COMPANY_ABBR=MF
DEMO_COUNTRY="Germany"
DEMO_CURRENCY=EUR
DEMO_TIMEZONE=Europe/Berlin

# Muss exakt einem hinterlegten Kontenrahmen entsprechen, sonst legt ERPNext
# die Firma an und stuerzt danach ab -- der Assistent meldet trotzdem Erfolg.
# Gueltig fuer Deutschland: SKR04 mit Kontonummern, SKR03 mit Kontonummern,
# Standard, Standard with Numbers.
DEMO_COA="SKR04 mit Kontonummern"

# Leer lassen = laufendes Jahr.
DEMO_FY_YEAR=
